---
// 站点导航：每一项是一个 { href, label }
// href 是网址路径（对应 src/pages/ 下的文件），label 是显示的文字
const links: { href: string; label: string }[] = [
  { href: '/', label: '首页' },
  { href: '/posts', label: '文章' },
  { href: '/about', label: '关于' }
];
---

<nav>
  {links.map((link) => <a href={link.href}>{link.label}</a>)}
</nav>
