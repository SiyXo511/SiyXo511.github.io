---
// 全站樱花飘落：一块铺满窗口的 canvas，垫在内容下面，不挡点击
---

<canvas id="sakura" aria-hidden="true"></canvas>

<style>
  #sakura {
    position: fixed;
    inset: 0; /* 上下左右都贴边 = 铺满窗口 */
    width: 100%;
    height: 100%;
    z-index: -1; /* 垫在页面内容下面，花瓣不会挡住文字 */
    pointer-events: none; /* 鼠标事件直接穿透，不影响点击链接 */
  }
</style>

<script>

  interface Petal {
    x: number;
    y: number;
    size: number;
    speedY: number; // 下落速度
    speedX: number; // 水平漂移速度
    angle: number; // 当前旋转角度
    spin: number; // 每帧转多少
    phase: number; // 左右摇摆用的相位，配合 Math.sin
  }

  const PETAL_COUNT = 36;

  const canvas = document.querySelector<HTMLCanvasElement>('#sakura');
  const ctx = canvas?.getContext('2d');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 新建一片花瓣；startOnScreen 为 true 时随机分布在屏幕里（页面刚打开时用），否则从顶部上方出现
  function createPetal(startOnScreen: boolean): Petal {
    return {
      x: Math.random() * window.innerWidth,
      y: startOnScreen ? Math.random() * window.innerHeight : -20,
      size: 5 + Math.random() * 5,
      speedY: 0.6 + Math.random() * 0.8,
      speedX: -0.3 + Math.random() * 0.6,
      angle: Math.random() * Math.PI * 2,
      spin: (Math.random() - 0.5) * 0.04,
      phase: Math.random() * Math.PI * 2,
    };
  }

  // 让花瓣动一帧。dt = 这一帧相当于几个"60fps 的帧"，乘上它，在 120Hz 屏幕上速度也一样
  function updatePetal(p: Petal, dt: number) {
    p.x += (p.speedX + Math.sin(p.phase) * 0.3) * dt
    p.y += p.speedY * dt
    p.phase += 0.02 * dt
    p.angle += p.spin * dt
    if(p.x > window.innerWidth + 10 || p.x < -10 || p.y > window.innerHeight + 10) {
      Object.assign(p, createPetal(false))
    }
  }

  // 画一片花瓣：两条贝塞尔曲线围成的水滴形
  function drawPetal(c: CanvasRenderingContext2D, p: Petal) {
    const s = p.size;
    c.save();
    c.translate(p.x, p.y); // 把原点移到花瓣位置
    c.rotate(p.angle); // 再旋转坐标系，下面就可以按"未旋转"的样子画
    c.beginPath();
    c.moveTo(0, -s);
    c.bezierCurveTo(s, -s * 0.6, s * 0.6, s * 0.8, 0, s);
    c.bezierCurveTo(-s * 0.6, s * 0.8, -s, -s * 0.6, 0, -s);
    c.fillStyle = 'rgba(249, 168, 212, 0.75)';
    c.fill();
    c.restore();
  }

  if (canvas && ctx && !reduceMotion) {
    // canvas 的绘图尺寸按设备像素比放大，Retina 屏上花瓣边缘才不会发虚
    const resize = () => {
      const dpr = window.devicePixelRatio || 1;
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize);

    const petals = Array.from({ length: PETAL_COUNT }, () => createPetal(true));

    let last = performance.now();
    const frame = (now: number) => {
      // 限制 dt 上限：切换标签页回来时，不会因为间隔太久让花瓣"瞬移"
      const dt = Math.min((now - last) / (1000 / 60), 3);
      last = now;

      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      for (const p of petals) {
        updatePetal(p, dt);
        drawPetal(ctx, p);
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>
