---
// 每个页面共用的外壳：<html>、<head> 都在这里，页面只需要关心自己的内容
import Nav from '../components/Nav.astro';
import SakuraFall from '../components/SakuraFall.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

// 只在线上网站统计访问：本地开发时自己刷新、调试的访问不要算进去
const isProduction = import.meta.env.PROD && import.meta.env.SITE === 'https://siyxo511.github.io';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- 声明 RSS 订阅源：阅读器和浏览器插件输入博客地址就能自动发现 -->
    <link rel="alternate" type="application/rss+xml" title="小莳的博客" href="/rss.xml" />
    <!-- 在页面绘制之前就套用记住的主题，避免先闪一下默认颜色 -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
        // 樱花开关同理：关掉过的读者，刷新时不会先闪出花瓣
        if (localStorage.getItem('sakura') === 'off') {
          document.documentElement.dataset.sakura = 'off';
        }
      } catch {}
    </script>
    <!-- Umami 访问统计：记录浏览量、来源、地区，不用 Cookie；ID 会公开在页面里，不是密钥 -->
    {
      isProduction && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id="8a2cf4b9-1a00-4960-9807-39a05524a8ed"
        />
      )
    }
  </head>
  <body>
    <SakuraFall />
    <Nav />
    <slot />
  </body>
</html>
