---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 构建时告诉 Astro：要为哪些文章各生成一个页面
export async function getStaticPaths() {
  const posts = await getCollection('posts', (post) => !post.data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, category, createdAt, updatedAt, tags } = post.data;
// 把 Markdown 正文编译成可以放进模板的组件
const { Content } = await render(post);
---

<BaseLayout title={title}>
  <article>
    <h1>{title}</h1>
    <p>
      {category}·
      <time datetime={createdAt.toISOString()}>
        {createdAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>·
      {updatedAt && <span>更新于 {updatedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>}
      {tags.map((tag) => <span>{tag}</span>)}
    </p>
    <Content />
  </article>
</BaseLayout>
