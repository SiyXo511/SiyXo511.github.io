---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import { getPublishedPosts, type Post } from '../../lib/posts';

// 构建时告诉 Astro：要为哪些文章各生成一个页面
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, category, createdAt, updatedAt, tags } = post.data;
// 把 Markdown 正文编译成可以放进模板的组件
const { Content } = await render(post);
---

<BaseLayout title={title}>
  <article>
    <h1>{title}</h1>
    <PostMeta category={category} createdAt={createdAt} updatedAt={updatedAt} tags={tags} />
    <Content />
  </article>
</BaseLayout>

<style>
  /* 正文是 <Content /> 渲染出来的，不带本组件的作用域标记，所以要用 :global() 才能选中里面的元素 */
  article :global(img) {
    display: block; /* 默认是行内元素，底部会留一条基线空隙 */
    max-width: 100%; /* 最宽不超过正文区，小图保持原尺寸 */
    height: auto; /* 宽度被缩小时，高度按比例跟着缩，不变形 */
    margin: 1.5rem auto;
    border-radius: 0.5rem;
  }
</style>
