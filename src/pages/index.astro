---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getPublishedPosts } from '../lib/posts';

// 首页显示最新的几篇文章
const LATEST_COUNT = 5;
const allPosts = await getPublishedPosts();
---

<BaseLayout title="我的博客">
  <section class="hero">
    <!-- 头像：暂时用 emoji，以后可以换成 <img> -->
    <div class="avatar" aria-hidden="true">🐷</div>
    <div>
      <h1>小莳</h1>
      <p class="tagline">一枚喜欢睡觉的🐷</p>
      <p class="bio">这里会展示我的经历、随笔和知识笔记。</p>
      <SocialLinks />
    </div>
  </section>

  <section>
    <h2>最新文章</h2>
    <PostList posts={allPosts.slice(0, LATEST_COUNT)} />
    { allPosts.length > LATEST_COUNT && <p class="more"><a href="/posts">查看全部文章 →</a></p> }
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 1rem 0 3rem;
  }

  .avatar {
    flex-shrink: 0; /* 名字很长时也不要把头像挤扁 */
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    font-size: 3rem;
    border-radius: 50%;
    background: var(--color-code-bg);
    /* 外圈用强调色描一道细环 */
    box-shadow: 0 0 0 3px var(--color-bg), 0 0 0 5px var(--color-accent);
  }

  .hero h1 {
    margin: 0;
    font-size: 1.75rem;
  }

  .tagline {
    margin: 0.25rem 0;
    font-family: var(--font-mono);
    color: var(--color-accent);
  }

  /* 终端提示符：纯装饰，用伪元素加，不进入正文内容 */
  .tagline::before {
    content: '$ ';
    color: var(--color-muted);
  }

  .bio {
    margin: 0;
    color: var(--color-muted);
  }

  /* 手机上改成上下排列 */
  @media (max-width: 480px) {
    .hero {
      flex-direction: column;
      text-align: center;
    }

    /* SocialLinks 是子组件，它的 class 带的是自己的作用域，要用 :global() 才能从这里选中 */
    .hero :global(.social) {
      justify-content: center;
    }
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-muted);
  }

  .more {
    text-align: right;
    font-size: 0.875rem;
  }
</style>
