---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getPublishedPosts } from '../lib/posts';

// 首页显示最新的几篇文章
const LATEST_COUNT = 5;
const allPosts = await getPublishedPosts();
---

<BaseLayout title="我的博客">
  <section class="hero">
    <!-- 头像：暂时用 emoji，以后可以换成 <img> -->
    <div class="avatar" aria-hidden="true">🐷</div>
    <div>
      <h1>小莳</h1>
      <p class="tagline">
        <!-- 读屏软件读这一份完整文字；下面逐字变化的那份对它隐藏，避免被念成一个个零碎的字 -->
        <span class="sr-only">一枚喜欢睡觉的🐷</span>
        <span class="typed" aria-hidden="true">一枚喜欢睡觉的🐷</span><span class="cursor" aria-hidden="true"></span>
      </p>
      <p class="bio">这里会展示我的经历、随笔和知识笔记。</p>
      <SocialLinks />
    </div>
  </section>

  <section>
    <h2>最新文章</h2>
    <PostList posts={allPosts.slice(0, LATEST_COUNT)} />
    { allPosts.length > LATEST_COUNT && <p class="more"><a href="/posts">查看全部文章 →</a></p> }
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 1rem 0 3rem;
  }

  .avatar {
    flex-shrink: 0; /* 名字很长时也不要把头像挤扁 */
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    font-size: 3rem;
    border-radius: 50%;
    background: var(--color-code-bg);
    /* 外圈用强调色描一道细环 */
    box-shadow: 0 0 0 3px var(--color-bg), 0 0 0 5px var(--color-accent);
  }

  .hero h1 {
    margin: 0;
    font-size: 1.75rem;
  }

  .tagline {
    margin: 0.25rem 0;
    font-family: var(--font-mono);
    color: var(--color-accent);
  }

  /* 终端提示符：纯装饰，用伪元素加，不进入正文内容 */
  .tagline::before {
    content: '$ ';
    color: var(--color-muted);
  }

  /* 终端风格的块状光标，一亮一灭 */
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.1em;
    vertical-align: text-bottom;
    background: var(--color-accent);
    animation: blink 1s step-end infinite;
  }

  /* step-end：不渐变，直接在亮和灭之间跳，更像真实的终端光标 */
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* 视觉上隐藏、但读屏软件能读到的常用写法 */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* 用户在系统里开启了"减少动态效果"时，光标也不闪 */
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .bio {
    margin: 0;
    color: var(--color-muted);
  }

  /* 手机上改成上下排列 */
  @media (max-width: 480px) {
    .hero {
      flex-direction: column;
      text-align: center;
    }

    /* SocialLinks 是子组件，它的 class 带的是自己的作用域，要用 :global() 才能从这里选中 */
    .hero :global(.social) {
      justify-content: center;
    }
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-muted);
  }

  .more {
    text-align: right;
    font-size: 0.875rem;
  }
</style>

<script>
  // 打字效果：HTML 里已经有完整文字（没有 JS 时也能看到），JS 先清空，再一个字一个字打出来
  const typed = document.querySelector<HTMLElement>('.typed');
  // 系统开启了"减少动态效果"，就直接显示完整文字
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (typed && !reduceMotion) {
    const text = typed.textContent ?? '';
    typed.textContent = '';
    const chars = Array.from(text);
    let count = 0;
    const timer = setInterval(() => {
      if (count >= chars.length) {
        clearInterval(timer);
        return;
      }
      typed.textContent += chars[count];
      count++;
    }, 500);
  }
</script>
